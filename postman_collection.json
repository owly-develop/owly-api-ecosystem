                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/featured/",
              "host": ["{{base_url}}"],
              "path": ["projects", "featured", ""]
            }
          }
        },
        {
          "name": "Projects by Location",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/by_location/",
              "host": ["{{base_url}}"],
