        }
      ]
    },
    {
      "name": "🏠 Units",
      "item": [
        {
          "name": "List Units",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/units/",
              "host": ["{{base_url}}"],
              "path": ["projects", "units", ""]
            }
          }
        },
        {
          "name": "Available Units (Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/units/?status=available&bedrooms=2&price_max=400000",
              "host": ["{{base_url}}"],
              "path": ["projects", "units", ""],
              "query": [
                {"key": "status", "value": "available"},
                {"key": "bedrooms", "value": "2"},
                {"key": "price_max", "value": "400000"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Analytics",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/analytics/dashboard/",
              "host": ["{{base_url}}"],
              "path": ["analytics", "dashboard", ""]
            }
          }
        },
        {
          "name": "Sales Funnel",
          "request": {
            "method": "GET",
